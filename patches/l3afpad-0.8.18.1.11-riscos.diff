diff -ruN a/src/riscos-windows.h b/src/riscos-windows.h
--- a/src/riscos-windows.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/riscos-windows.h	2026-10-07 11:16:53.042100884 +0100
@@ -0,0 +1,27 @@
+/* riscos-windows.h - riscos-gtk: L3afpad on RISC OS keeps a window per
+ * document in one task. L3afpad keeps a window's state in file-level
+ * variables; each file lists those here, and riscos-l3afpad.c swaps them
+ * (with pub) when another window is used. GPL-2.0-or-later, as L3afpad.
+ * Copyright (C) 2026 Andrew Youll. */
+#ifndef RISCOS_WINDOWS_H
+#define RISCOS_WINDOWS_H
+
+#include <stddef.h>
+
+typedef struct {
+	void *address;
+	size_t size;
+} L3State;
+
+#define L3_STATE_TABLE(name) const L3State l3_state_##name[] =
+#define L3_VAR(v) { (void *) &(v), sizeof (v) }
+#define L3_END { NULL, 0 }
+
+/* riscos-l3afpad.c */
+void riscos_l3afpad_new_window(void);
+void riscos_l3afpad_close_window(void);
+void riscos_l3afpad_quit(void);
+void riscos_l3afpad_empty(void);
+void riscos_l3afpad_window_created(void);
+
+#endif
