 else
 	SYSTEM_CFLAGS=$PNG_CFLAGS
 	SYSTEM_LIBS="$PNG_LIBS -ljpeg"
-	deps_pkgs="$deps_pkgs $gtk_pkgs x11"
+	deps_pkgs="$deps_pkgs $gtk_pkgs"
 fi
 
 PKG_CHECK_MODULES(DEPS,[$deps_pkgs])
