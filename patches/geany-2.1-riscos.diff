@@ -556,6 +556,37 @@
 }
 
 
+#if defined __riscos__ || defined GEANY_RISCOS_UI
+/* riscos-gtk: RISC OS keeps C sources as c.hello as well as hello/c. GTK
+ * turns UnixLib's suffix swapping off, so a file in a folder named after
+ * a suffix (UnixLib's list: c cc f h i ii l o p s y) reaches Geany as
+ * .../c/hello. Returns the name it stands for ("hello.c"), and the
+ * folder above in *dir if dir isn't NULL, or NULL for any other file. */
+static gchar *riscos_suffix_name(const gchar *file_name, gchar **dir)
+{
+	static const gchar *const sfx[] = { "c", "cc", "f", "h", "i", "ii", "l", "o", "p", "s", "y", NULL };
+	gchar *parent = g_path_get_dirname(file_name);
+	gchar *suffix = g_path_get_basename(parent);
+	gchar *leaf = g_path_get_basename(file_name);
+	gchar *name = NULL;
+	guint i;
+
+	if (strchr(leaf, '.') == NULL)
+		for (i = 0; sfx[i]; i++)
+			if (g_ascii_strcasecmp(suffix, sfx[i]) == 0)
+			{
+				name = g_strconcat(leaf, ".", sfx[i], NULL);
+				if (dir)
+					*dir = g_path_get_dirname(parent);
+				break;
+			}
+	g_free(parent);
+	g_free(suffix);
+	g_free(leaf);
+	return name;
+}
+#endif
