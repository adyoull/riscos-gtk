diff -ruN png-orig/contrib/arm-neon/riscos.c libpng-1.6.37/contrib/arm-neon/riscos.c
--- a/contrib/arm-neon/riscos.c	1970-01-01 01:00:00.000000000 +0100
+++ b/contrib/arm-neon/riscos.c	2026-11-10 12:37:58.208561769 +0000
@@ -0,0 +1,19 @@
+/* contrib/arm-neon/riscos.c
+ *
+ * png_have_neon for RISC OS (riscos-gtk), for PNG_ARM_NEON_FILE: NEON if
+ * VFPSupport_Features 0 (SWI &58EC8; R2 = MVFR1) shows Advanced SIMD loads
+ * and stores (bits 8-11) and integer operations (bits 12-15), as UnixLib
+ * reads it. Released under the libpng licence.
+ */
+#include <kernel.h>
+
+static int
+png_have_neon(png_structp png_ptr)
+{
+   _kernel_swi_regs r;
+
+   PNG_UNUSED(png_ptr)
+   r.r[0] = 0;
+   return _kernel_swi(0x58EC8, &r, &r) == NULL &&
+      ((r.r[2] >> 8) & 0xF) != 0 && ((r.r[2] >> 12) & 0xF) != 0;
+}
