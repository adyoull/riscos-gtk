+		break;
+	case PANGO_ATTR_FONT_DESC: {
+		char *desc = pango_font_description_to_string (((PangoAttrFontDesc*)attr)->desc);
+		g_print  ("    font=\"%s\"\n", desc);
+		g_free (desc);
+		break;
+	}
+	default:
+		g_print ("    type=%s\n", enum_name (PANGO_TYPE_ATTR_TYPE, attr->klass->type));
+	}
+
+	return FALSE;
+}
