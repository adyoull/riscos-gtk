+
+	sheet_object_anchor_init (&anchor, NULL, NULL,
+		GOD_ANCHOR_DIR_DOWN_RIGHT, GNM_SO_ANCHOR_TWO_CELLS);
+	coords[0] = coords[2] = x;
+	coords[1] = coords[3] = y;
+	scg_object_coords_to_anchor (scg, coords, &anchor);
+	scg_image_create (scg, &anchor, data, len);
+}
