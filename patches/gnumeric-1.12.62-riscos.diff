+static const char *
+enum_name (GType typ, int i)
+{
+	static char result[100];
+	GEnumClass *ec = g_type_class_ref (typ);
+
+	if (ec) {
+		GEnumValue *ev = g_enum_get_value (ec, i);
+		g_type_class_unref (ec);
+
+		if (ev && ev->value_nick)
+			return ev->value_nick;
+		if (ev && ev->value_name)
+			return ev->value_name;
+	}
+
+	sprintf (result, "%d", i);
+	return result;
+}
