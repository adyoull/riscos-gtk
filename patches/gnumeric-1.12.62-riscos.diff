+static void
+wbcg_set_selection_valign (WBCGtk *wbcg, GnmVAlign valign)
+{
+	WorkbookControl *wbc = GNM_WBC (wbcg);
+	WorkbookView	*wb_view;
+	GnmStyle *style;
+
+	if (wbcg->updating_ui)
+		return;
+
+	/* This is a toggle button.  If we are already enabled
+	 * then revert to general */
