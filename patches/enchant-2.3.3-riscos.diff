 static const char *empty_string = "";
 
+/* riscos-gtk: a dictionary in UTF-8 (LibreOffice's are) needs no
+   conversion, so iconv (RISC OS's Iconv module) isn't asked for one.
+   Without the module g_iconv_open failed, its (GIConv) -1 was taken as
+   valid, and every word was reported misspelt. */
+#define ICONV_SAME ((GIConv) 1)
+
 static char *do_iconv(GIConv conv, const char *word) {
+	if (conv == ICONV_SAME)
+		return strdup(word);
 	// g_iconv() does not declare its 'in' parameter const, but iconv() does.
 	char *in = const_cast<char *>(word);
 	size_t len_in = strlen(in);
