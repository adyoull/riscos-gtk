riscos-gtk's changes to enchant 2.3.3 (ENCHANT_RISCOS):
- no dlopen: the hunspell provider is linked in (build/build-spell.sh
  renames its init_enchant_provider); NULL module handled;
- dictionaries for every GTK program in <Choices$Write>.GTK.Dictionaries
  (first), personal word lists in <Choices$Write>.GTK.Enchant.
--- a/src/lib.c	2022-04-16 15:09:31.000000000 +0100
+++ b/src/lib.c	2026-10-27 13:47:36.995171429 +0000
@@ -118,6 +118,16 @@
 	const gchar * env = g_getenv("ENCHANT_CONFIG_DIR");
 	if (env)
 		return g_filename_to_utf8(env, -1, NULL, NULL, NULL);
+#ifdef ENCHANT_RISCOS
+	/* riscos-gtk: every GTK program's personal word lists in one place,
+	   <Choices$Write>.GTK.Enchant */
+	if (g_getenv ("Choices$Write"))
+#ifdef __riscos__
+		return g_strdup ("/<Choices$Write>/GTK/Enchant");
+#else	/* (the tests, on Linux) */
+		return g_build_filename (g_getenv ("Choices$Write"), "GTK", "Enchant", NULL);
+#endif
+#endif
 	return g_build_filename (g_get_user_config_dir (), "enchant", NULL);
 }
 
@@ -730,7 +740,7 @@
 	if (provider)
 		{
 			GModule *module = (GModule *) provider->enchant_private_data;
-			file = g_module_name (module);
+			file = module ? g_module_name (module) : "built in";
 			name = (*provider->identify) (provider);
 			desc = (*provider->describe) (provider);
 		}
@@ -875,6 +885,23 @@
 	g_dir_close (dir);
 }
 
+#ifdef ENCHANT_RISCOS
+/* riscos-gtk: no dlopen on RISC OS; the hunspell provider is linked in
+   (its init_enchant_provider renamed; it has no configure function) */
+EnchantProvider *init_enchant_provider_hunspell (void);
+
+static void
+enchant_load_providers (EnchantBroker * broker)
+{
+	EnchantProvider *provider = init_enchant_provider_hunspell ();
+
+	if (!enchant_provider_is_valid (provider))
+		return;
+	provider->enchant_private_data = NULL;
+	provider->owner = broker;
+	broker->provider_list = g_slist_append (broker->provider_list, (gpointer)provider);
+}
+#else
 static void
 enchant_load_providers (EnchantBroker * broker)
 {
@@ -883,6 +910,7 @@
 		enchant_load_providers_in_dir (broker, module_dir);
 	free (module_dir);
 }
+#endif
 
 static void
 enchant_load_ordering_from_file (EnchantBroker * broker, const char * file)
@@ -993,13 +1021,16 @@
 	(*provider->dispose) (provider);
 
 	/* close module only after invoking dispose */
-	g_module_close (module);
+	if (module)	/* (riscos-gtk: NULL for a built-in provider) */
+		g_module_close (module);
 }
 
