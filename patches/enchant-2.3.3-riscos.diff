+#endif
 
 	EnchantBroker *broker = g_new0 (EnchantBroker, 1);
 	broker->dict_map = g_hash_table_new_full (g_str_hash, g_str_equal,
@@ -1137,7 +1168,7 @@
 
 			const char *name = (*provider->identify) (provider);
 			const char *desc = (*provider->describe) (provider);
-			const char *file = g_module_name (module);
+			const char *file = module ? g_module_name (module) : "built in";
 
 			(*fn) (name, desc, file, user_data);
 		}
@@ -1201,7 +1232,7 @@
 			GModule *module = (GModule *) provider->enchant_private_data;
 			const char *name = (*provider->identify) (provider);
 			const char *desc = (*provider->describe) (provider);
-			const char *file = g_module_name (module);
+			const char *file = module ? g_module_name (module) : "built in";
 			(*fn) (tag, name, desc, file, user_data);
 		}
 
--- a/providers/enchant_hunspell.cpp	2022-04-16 15:09:31.000000000 +0100
+++ b/providers/enchant_hunspell.cpp	2026-10-27 13:20:32.999135249 +0000
@@ -170,6 +170,23 @@
 {
 	dirs.clear ();
 
+#ifdef ENCHANT_RISCOS
+	/* riscos-gtk: dictionaries for every GTK program, added by the user:
+	   <Choices$Write>.GTK.Dictionaries (en_GB.dic and en_GB.aff ...);
+	   then the program's own (share/hunspell in its folder, by way of
+	   XDG_DATA_DIRS) */
+	if (g_getenv ("Choices$Write"))
+		{
+#ifdef __riscos__
+			dirs.push_back ("/<Choices$Write>/GTK/Dictionaries");
+#else	/* (the tests, on Linux) */
+			gchar *c = g_build_filename (g_getenv ("Choices$Write"), "GTK", "Dictionaries", nullptr);
+			dirs.push_back (c);
+			g_free (c);
+#endif
+		}
+#endif
+
 	char * config_dir = enchant_get_user_config_dir ();
 	gchar * tmp = g_build_filename (config_dir, "hunspell", nullptr);
 	dirs.push_back (tmp);
