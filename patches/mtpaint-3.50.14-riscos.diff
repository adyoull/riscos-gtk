+#ifdef U_FPICK_RISCOS		/* RISC OS: Save box / Open box style */
+
+/* The window: the file icon (a Save: drag it to a directory display, or to
+ * another program), the file's full RISC OS name, Browse... (riscos-gtk's
+ * Save or Open box, or its directory browser); mtPaint's options; Cancel
+ * and OK. A file (or a directory) dragged here from a directory display is
+ * chosen. Names are RISC OS ones here, UnixLib ones to mtPaint. */
+
+typedef struct {
+	GtkWidget *win, *entry, *icon;
+	void **ok, **cancel;
+	int flags;
+	char *sprite;
+	char *dir;		// UnixLib name of the folder for a bare leaf name
+	char *saved;		// RISC OS name a save drag gave
+	gboolean pressed, dragging;
+	double px, py;
+} ro_fpick;
+
+static const struct { const char *ext; int type; } ro_types[] = {
+	{ "png", 0xB60 }, { "jpg", 0xC85 }, { "jpeg", 0xC85 }, { "gif", 0x695 },
+	{ "bmp", 0x69C }, { "tif", 0xFF0 }, { "tiff", 0xFF0 }, { "txt", 0xFFF },
+	{ "gpl", 0xFFF }, { "xpm", 0xFFF }, { "webp", 0xA66 },
+};
+
+static int ro_leaf_type(const char *name)
+{
+	const char *leaf = strrchr(name, '.'), *ext;
+	unsigned i;
+	leaf = leaf ? leaf + 1 : name;
+	ext = strrchr(leaf, '/');
+	if (!ext) return (0xFFD);
+	for (i = 0; i < sizeof(ro_types) / sizeof(ro_types[0]); i++)
+		if (!g_ascii_strcasecmp(ext + 1, ro_types[i].ext)) return (ro_types[i].type);
+	return (0xFFD);
+}
+
+static void ro_set_icon(ro_fpick *f)
+{
+	char sprite[16];
+	GdkPixbuf *pb;
+	GtkWidget *img;
+
+	if (!f->icon) return;
+	sprintf(sprite, "file_%03x", ro_leaf_type(gtk_entry_get_text(GTK_ENTRY(f->entry))));
+	if (f->sprite && !strcmp(f->sprite, sprite)) return;
+	g_free(f->sprite);
+	f->sprite = g_strdup(sprite);
+	pb = gdk_riscos_wimp_sprite(sprite);
+	if (!pb)
+	{
+		g_free(f->sprite);
+		f->sprite = g_strdup("file_xxx");
+		pb = gdk_riscos_wimp_sprite(f->sprite);
+	}
+	img = pb ? gtk_image_new_from_pixbuf(pb) :
+		gtk_image_new_from_icon_name("image-x-generic", GTK_ICON_SIZE_DIALOG);
+	if (pb) g_object_unref(pb);
+	if (gtk_bin_get_child(GTK_BIN(f->icon)))
+		gtk_widget_destroy(gtk_bin_get_child(GTK_BIN(f->icon)));
+	gtk_container_add(GTK_CONTAINER(f->icon), img);
+	gtk_widget_show(img);
+}
+
+static int ro_is_full(const char *name)
+{
+	/* (a leaf can't have a '.': that's the directory separator) */
+	return (strchr(name, ':') || strchr(name, '$') || strchr(name, '.') || (name[0] == '<') ||
+		(name[0] == '@') || (name[0] == '&') || (name[0] == '%'));
+}
+
+/* The entry's name as a UnixLib name */
+static char *ro_unix_name(ro_fpick *f)
+{
+	const char *t = gtk_entry_get_text(GTK_ENTRY(f->entry));
+	char *u;
+
+	if (!t[0]) return (g_strdup(f->dir ? f->dir : ""));
+	if (ro_is_full(t)) return (gdk_riscos_path_to_unix(t));
+	u = gdk_riscos_path_to_unix(t);	// "/leaf"
+	if (f->dir)
+	{
+		char *full = g_strconcat(f->dir, u + 1, NULL);
+		g_free(u);
+		return (full);
+	}
+	return (u);
+}
+
+static void ro_show_name(ro_fpick *f, const char *unix_name)
+{
+	char *d, *ro;
+
+	/* Remember the folder, for a bare leaf typed later */
+	d = g_path_get_dirname(unix_name);
+	g_free(f->dir);
+	f->dir = g_strconcat(d, d[strlen(d) - 1] == '/' ? "" : "/", NULL);
+	g_free(d);
+	ro = unix_name[0] == '/' ? gdk_riscos_path_from_unix(unix_name) : g_strdup(unix_name);
+	/* No name yet (a new picture): Untitled, as a RISC OS Save box */
+	if (f->icon && ro[0] && (ro[strlen(ro) - 1] == '.'))
+	{
+		char *t = g_strconcat(ro, "Untitled", NULL);
+		g_free(ro);
+		ro = t;
+	}
+	gtk_entry_set_text(GTK_ENTRY(f->entry), ro);
+	gtk_editable_set_position(GTK_EDITABLE(f->entry), -1);
+	g_free(ro);
+	ro_set_icon(f);
+}
+
+static gboolean ro_ok_idle(gpointer data)
+{
+	ro_fpick *f = data;
+	char *saved = f->saved;
+
+	f->saved = NULL;
+	do_evt_1_d(f->ok);	// mtPaint saves or loads; the window may go
+	/* After a drag save: tell the receiver it's there */
+	if (saved) gdk_riscos_save_done(saved);
+	g_free(saved);
+	return (FALSE);
+}
+
+/* The receiver of a save drag answered: save there */
+static void ro_save_to(const char *riscos_path, gboolean safe, gpointer data)
+{
+	ro_fpick *f = data;
+	char *u = gdk_riscos_path_to_unix(riscos_path);
+
+	ro_show_name(f, u);
+	g_free(u);
+	g_free(f->saved);
+	f->saved = g_strdup(riscos_path);
+	g_idle_add(ro_ok_idle, f);
+}
+
+static gboolean ro_icon_press(GtkWidget *w, GdkEventButton *ev, ro_fpick *f)
+{
+	if ((ev->type != GDK_BUTTON_PRESS) || (ev->button != 1)) return (FALSE);
+	f->pressed = TRUE;
+	f->dragging = FALSE;
+	f->px = ev->x_root;
+	f->py = ev->y_root;
+	return (TRUE);
+}
+
+static gboolean ro_icon_motion(GtkWidget *w, GdkEventMotion *ev, ro_fpick *f)
+{
+	GtkAllocation a;
+	int x = 0, y = 0, ox = 0, oy = 0;
+
+	if (!f->pressed || f->dragging) return (FALSE);
+	if ((ABS(ev->x_root - f->px) < 4) && (ABS(ev->y_root - f->py) < 4)) return (TRUE);
+	f->dragging = TRUE;
+	gtk_widget_get_allocation(f->icon, &a);
+	gtk_widget_translate_coordinates(f->icon, f->win, 0, 0, &x, &y);
+	gdk_window_get_origin(gtk_widget_get_window(f->win), &ox, &oy);
+	gdk_riscos_save_drag_begin(gtk_widget_get_display(w), f->sprite,
+		ox + x, oy + y, a.width, a.height);
+	return (TRUE);
+}
+
+static gboolean ro_icon_release(GtkWidget *w, GdkEventButton *ev, ro_fpick *f)
+{
+	const char *t, *leaf;
+
+	if ((ev->button != 1) || !f->pressed) return (FALSE);
+	f->pressed = FALSE;
+	if (!f->dragging) return (TRUE);
+	f->dragging = FALSE;
+	t = gtk_entry_get_text(GTK_ENTRY(f->entry));
+	leaf = strrchr(t, '.');
+	leaf = leaf ? leaf + 1 : t;
+	if (strrchr(leaf, ':')) leaf = strrchr(leaf, ':') + 1;
+	gdk_riscos_save_drop(gtk_widget_get_display(w), leaf[0] ? leaf : "Picture",
+		ro_leaf_type(t), 0, ro_save_to, f);
+	return (TRUE);
+}
+
+/* A file or directory dragged here from the Filer */
+static gboolean ro_load(const char *riscos_path, int filetype, gpointer data)
+{
+	ro_fpick *f = data;
+	int dir = (filetype == 0x1000) || (filetype == 0x2000);
+	char *u;
+
+	if ((f->flags & FPICK_DIRS_ONLY) ? !dir : 0) return (FALSE);
+	u = gdk_riscos_path_to_unix(riscos_path);
+	if (dir && !(f->flags & FPICK_DIRS_ONLY))
+	{
+		/* A directory: the folder to save in (or look in) */
+		char *in = g_strconcat(u, "/", gtk_entry_get_text(GTK_ENTRY(f->entry))[0] ?
+			strrchr(ro_unix_name(f), '/') + 1 : "", NULL);
+		ro_show_name(f, in);
+		g_free(in);
+		g_free(u);
+		return (TRUE);
+	}
+	ro_show_name(f, u);
+	g_free(u);
+	if (f->flags & FPICK_LOAD) g_idle_add(ro_ok_idle, f);
+	return (TRUE);
+}
+
+static void ro_realize(GtkWidget *w, ro_fpick *f)
+{
+	gdk_riscos_window_set_load_func(gtk_widget_get_window(w), ro_load, f);
+}
+
+static void ro_browse_response(GtkNativeDialog *d, int r, ro_fpick *f)
+{
+	if (r == GTK_RESPONSE_ACCEPT)
+	{
+		char *u = gtk_file_chooser_get_filename(GTK_FILE_CHOOSER(d));
+		if (u)
+		{
+			if (f->flags & FPICK_DIRS_ONLY)
+			{
+				char *s = g_strconcat(u, "/", NULL);
+				ro_show_name(f, s);
+				g_free(s);
+			}
+			else ro_show_name(f, u);
+			g_free(u);
+			g_idle_add(ro_ok_idle, f);
+		}
+	}
+	g_object_unref(d);
+}
+
+static void ro_browse(GtkWidget *b, ro_fpick *f)
+{
+	GtkFileChooserAction act = f->flags & FPICK_DIRS_ONLY ?
+		GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER : f->flags & FPICK_LOAD ?
+		GTK_FILE_CHOOSER_ACTION_OPEN : GTK_FILE_CHOOSER_ACTION_SAVE;
+	GtkFileChooserNative *n = gtk_file_chooser_native_new(
+		gtk_window_get_title(GTK_WINDOW(f->win)), GTK_WINDOW(f->win), act, NULL, NULL);
+	char *u = ro_unix_name(f), *d = g_path_get_dirname(u);
+
+	gtk_native_dialog_set_modal(GTK_NATIVE_DIALOG(n), TRUE);
+	if (d[0] == '/') gtk_file_chooser_set_current_folder(GTK_FILE_CHOOSER(n), d);
+	if (act == GTK_FILE_CHOOSER_ACTION_SAVE)
+	{
+		char *leaf = g_path_get_basename(u);
+		gtk_file_chooser_set_current_name(GTK_FILE_CHOOSER(n), leaf);
+		g_free(leaf);
+	}
+	g_free(d);
+	g_free(u);
+	g_signal_connect(n, "response", G_CALLBACK(ro_browse_response), f);
+	gtk_native_dialog_show(GTK_NATIVE_DIALOG(n));
+}
+
+static void ro_changed(GtkEditable *e, ro_fpick *f)
+{
+	ro_set_icon(f);
+}
+
+static void ro_ok(GtkWidget *w, ro_fpick *f)
+{
+	do_evt_1_d(f->ok);
+}
+
+static void ro_cancel(GtkWidget *w, ro_fpick *f)
+{
+	do_evt_1_d(f->cancel);
+}
+
+static gboolean ro_delete(GtkWidget *w, GdkEvent *ev, ro_fpick *f)
+{
+	do_evt_1_d(f->cancel);
+	return (TRUE);
+}
+
+static gboolean ro_key(GtkWidget *w, GdkEventKey *ev, ro_fpick *f)
+{
+	if (ev->keyval != GDK_KEY_Escape) return (FALSE);
+	do_evt_1_d(f->cancel);
+	return (TRUE);
+}
+
+static void ro_free(ro_fpick *f)
+{
+	g_idle_remove_by_data(f);
+	g_free(f->sprite);
+	g_free(f->dir);
+	g_free(f->saved);
+	g_free(f);
+}
+
+GtkWidget *fpick(GtkWidget **box, char *title, int flags, void **r)
+{
+	ro_fpick *f = g_new0(ro_fpick, 1);
+	GtkWidget *vb, *row, *w, *bb;
+	int save = !(flags & (FPICK_LOAD | FPICK_DIRS_ONLY));
+
+	f->flags = flags;
+	f->ok = NEXT_SLOT(r);
+	f->cancel = SLOT_N(r, 2);
+	f->win = gtk_window_new(GTK_WINDOW_TOPLEVEL);
+	gtk_window_set_title(GTK_WINDOW(f->win), __(title));
+	g_object_set_data_full(G_OBJECT(f->win), "mtPaint.rofpick", f, (GDestroyNotify)ro_free);
+	g_signal_connect(f->win, "delete-event", G_CALLBACK(ro_delete), f);
+	g_signal_connect(f->win, "key-press-event", G_CALLBACK(ro_key), f);
+	g_signal_connect(f->win, "realize", G_CALLBACK(ro_realize), f);
+
+	vb = gtk_box_new(GTK_ORIENTATION_VERTICAL, 6);
+	gtk_container_set_border_width(GTK_CONTAINER(vb), 8);
+	gtk_container_add(GTK_CONTAINER(f->win), vb);
+
+	row = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 6);
+	gtk_box_pack_start(GTK_BOX(vb), row, FALSE, FALSE, 0);
+	if (save)
+	{
+		f->icon = gtk_event_box_new();
+		gtk_event_box_set_visible_window(GTK_EVENT_BOX(f->icon), FALSE);
+		gtk_widget_add_events(f->icon, GDK_BUTTON_PRESS_MASK |
+			GDK_BUTTON_RELEASE_MASK | GDK_BUTTON_MOTION_MASK);
+		gtk_widget_set_size_request(f->icon, 34, 34);
+		gtk_widget_set_tooltip_text(f->icon,
+			_("Drag this icon to a directory display to save"));
+		g_signal_connect(f->icon, "button-press-event", G_CALLBACK(ro_icon_press), f);
+		g_signal_connect(f->icon, "motion-notify-event", G_CALLBACK(ro_icon_motion), f);
+		g_signal_connect(f->icon, "button-release-event", G_CALLBACK(ro_icon_release), f);
+		gtk_box_pack_start(GTK_BOX(row), f->icon, FALSE, FALSE, 0);
+	}
+	f->entry = gtk_entry_new();
+	gtk_entry_set_activates_default(GTK_ENTRY(f->entry), TRUE);
+	gtk_entry_set_width_chars(GTK_ENTRY(f->entry), 36);
+	gtk_widget_set_valign(f->entry, GTK_ALIGN_CENTER);
+	g_signal_connect(f->entry, "changed", G_CALLBACK(ro_changed), f);
+	gtk_box_pack_start(GTK_BOX(row), f->entry, TRUE, TRUE, 0);
+	w = gtk_button_new_with_label(_("Browse..."));
+	gtk_widget_set_valign(w, GTK_ALIGN_CENTER);
+	g_signal_connect(w, "clicked", G_CALLBACK(ro_browse), f);
+	gtk_box_pack_start(GTK_BOX(row), w, FALSE, FALSE, 0);
+
+	w = gtk_label_new(save ? _("Drag the icon to a directory display to save, or give a full name") :
+		flags & FPICK_DIRS_ONLY ? _("Drag a directory here from a directory display, or give its full name") :
+		_("Drag a file here from a directory display, or give its full name"));
+	gtk_label_set_xalign(GTK_LABEL(w), 0);
+	gtk_box_pack_start(GTK_BOX(vb), w, FALSE, FALSE, 0);
+
+	/* mtPaint's options */
+	*box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+	gtk_box_pack_start(GTK_BOX(vb), *box, FALSE, FALSE, 0);
+
+	bb = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 8);
+	gtk_box_set_homogeneous(GTK_BOX(bb), TRUE);
+	gtk_widget_set_halign(bb, GTK_ALIGN_END);
+	gtk_box_pack_end(GTK_BOX(vb), bb, FALSE, FALSE, 0);
+	w = gtk_button_new_with_label(_("Cancel"));
+	g_signal_connect(w, "clicked", G_CALLBACK(ro_cancel), f);
+	gtk_box_pack_start(GTK_BOX(bb), w, TRUE, TRUE, 0);
+	w = gtk_button_new_with_label(save ? _("Save") : _("OK"));
+	gtk_widget_set_can_default(w, TRUE);
+	g_signal_connect(w, "clicked", G_CALLBACK(ro_ok), f);
+	gtk_box_pack_start(GTK_BOX(bb), w, TRUE, TRUE, 0);
+	gtk_window_set_default(GTK_WINDOW(f->win), w);
+
+	gtk_widget_show_all(vb);
