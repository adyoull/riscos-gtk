--- a/inffast.c	2026-11-25 19:14:23.441681809 +0000
+++ b/inffast.c	2026-11-25 19:14:48.482288588 +0000
@@ -47,6 +47,29 @@
       requires strm->avail_out >= 258 for each loop to avoid checking for
       output space.
  */
+#ifdef Z_RISCOS_NEON
+/* riscos-gtk: a match copied 16 bytes at a time with NEON (len >= 16;
+   out - from >= 16 or from in another buffer, so every 16 bytes read are
+   already there) */
+#pragma GCC push_options
+#pragma GCC target ("fpu=neon")
+#include <arm_neon.h>
+local unsigned char FAR *chunk_copy(unsigned char FAR *out,
+                                    const unsigned char FAR *from,
+                                    unsigned len) {
+    do {
+        vst1q_u8(out, vld1q_u8(from));
+        out += 16;
+        from += 16;
+        len -= 16;
+    } while (len >= 16);
+    while (len--)
+        *out++ = *from++;
+    return out;
+}
+#pragma GCC pop_options
+#endif
