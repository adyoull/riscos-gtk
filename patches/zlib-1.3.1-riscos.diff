diff -ruN a/zutil.c b/zutil.c
--- a/zutil.c	2026-11-25 19:14:23.442470863 +0000
+++ b/zutil.c	2026-11-25 19:14:48.481134382 +0000
@@ -297,3 +297,33 @@
 #endif /* MY_ZCALLOC */
 
 #endif /* !Z_SOLO */
+
+#ifdef Z_RISCOS_NEON
+#ifdef __riscos
+#  include <kernel.h>
+#else
+#  include <sys/auxv.h>
+#endif
+#include <stdlib.h>
+
+/* Is there NEON? Read once. */
+int ZLIB_INTERNAL z_riscos_neon(void) {
+    static int neon = -1;
+
+    if (neon < 0) {
+        const char *off = getenv("RISCOS_GTK_NO_NEON");
+#ifdef __riscos
+        _kernel_swi_regs r;
+
+        r.r[0] = 0;                     /* VFPSupport_Features 0: MVFR1 in R2 */
+        neon = _kernel_swi(0x58EC8, &r, &r) == NULL &&
+               ((r.r[2] >> 8) & 0xF) != 0 && ((r.r[2] >> 12) & 0xF) != 0;
+#else
+        neon = (getauxval(AT_HWCAP) & 4096) != 0;   /* HWCAP_NEON */
+#endif
+        if (off != NULL && atoi(off) != 0)
+            neon = 0;
+    }
+    return neon;
+}
+#endif
