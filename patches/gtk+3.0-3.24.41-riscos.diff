+  for (i = 0; i < G_N_ELEMENTS (ids); i++)
+    if (gtk_dialog_get_widget_for_response (GTK_DIALOG (dialog), ids[i]))
+      return ids[i];
+  return GTK_RESPONSE_ACCEPT;
+}
