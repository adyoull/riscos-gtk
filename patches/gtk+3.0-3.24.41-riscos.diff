+{
+  int id;
+
+  if (accept)
+    {
+      id = _gtk_file_chooser_dialog_riscos_accept_id (dialog);
+      /* the file comes from the box, not the (unseen) file list */
+      dialog->priv->response_requested = TRUE;
+    }
+  else if (!deleted && gtk_dialog_get_widget_for_response (GTK_DIALOG (dialog), GTK_RESPONSE_CANCEL))
+    id = GTK_RESPONSE_CANCEL;
+  else
+    id = GTK_RESPONSE_DELETE_EVENT;
+  gtk_dialog_response (GTK_DIALOG (dialog), id);
