+/* The handshake: AcornSSL_CreateSession on the socket, the name, FIONBIO,
+   then 1-byte peeks (each Recv takes the handshake a step on; ENOTCONN until
+   it's over, longer while the user is asked about a certificate) */
+int gnutls_handshake (gnutls_session_t s)
+{
+	_kernel_swi_regs r;
+	_kernel_oserror *e;
+	int one = 1;
+	long got;
+	unsigned char peek;
+	gint64 start;
+
+	if (s->handle == 0) {
+		if ((e = _kernel_swi (XAcornSSL_Version, &r, &r)) != NULL) {
+			g_snprintf (last_error, sizeof last_error, "%s",
+				    e->errnum == RISCOS_SWI_NOT_KNOWN ?
+				    _("secure connections need RISC OS's AcornSSL module "
+				      "(RMLoad System:Modules.Network.URL.AcornSSL)") : e->errmess);
+			g_strlcpy (s->error, last_error, sizeof s->error);
+			return GNUTLS_E_PUSH_ERROR;
+		}
+		debug_print ("AcornSSL %d.%02d\n", r.r[0] / 100, r.r[0] % 100);
+		r.r[0] = __get_ro_socket (s->fd);
+		r.r[1] = 0;
+		r.r[2] = 0;
+		if ((e = _kernel_swi (XAcornSSL_CreateSession, &r, &r)) != NULL) {
+			note_error (s, "AcornSSL_CreateSession", e);
+			return GNUTLS_E_PUSH_ERROR;
+		}
+		s->handle = r.r[0];
+		if (s->hostname) {
+			r.r[0] = s->handle;
+			r.r[1] = ACORNSSL_SOL_SOCKET;
+			r.r[2] = SO_ACORNSSL_HOSTNAME;
+			r.r[3] = (int) (intptr_t) s->hostname;
+			r.r[4] = sizeof (const char *);
+			if ((e = _kernel_swi (XAcornSSL_Setsockopt, &r, &r)) != NULL) {
+				note_error (s, "AcornSSL: the server's name", e);
+				return GNUTLS_E_PUSH_ERROR;
+			}
+		}
+		r.r[0] = s->handle;
+		r.r[1] = ACORNSSL_FIONBIO;
+		r.r[2] = (int) (intptr_t) &one;
+		if ((e = _kernel_swi (XAcornSSL_Ioctl, &r, &r)) != NULL) {
+			note_error (s, "AcornSSL: FIONBIO", e);
+			return GNUTLS_E_PUSH_ERROR;
+		}
+	}
+	start = g_get_monotonic_time ();
+	for (;;) {
+		e = ssl_io (XAcornSSL_Recv, s->handle, &peek, 1, ACORNSSL_MSG_PEEK, &got);
+		if (e == NULL || dci4_errno (e) == DCI4_EWOULDBLOCK)
+			return 0;                               /* done */
+		if (dci4_errno (e) != DCI4_ENOTCONN && dci4_errno (e) != DCI4_EINPROGRESS) {
+			note_error (s, _("TLS handshake"), e);
+			return GNUTLS_E_PULL_ERROR;
+		}
+		if (g_get_monotonic_time () - start > (gint64) HANDSHAKE_SECONDS * G_USEC_PER_SEC) {
+			g_snprintf (last_error, sizeof last_error, _("TLS handshake: timed out"));
+			g_strlcpy (s->error, last_error, sizeof s->error);
+			return GNUTLS_E_PULL_ERROR;
+		}
+		/* the desktop goes on (AcornSSL's certificate question needs
+		   it): from the main thread, Claws Mail's idle; IMAP's thread
+		   (libetpan) just waits, while the main thread polls */
+		if (g_thread_self () == main_thread)
+			claws_do_idle ();
+		g_usleep (1000);
+	}
+}
+
+static long record_error (gnutls_session_t s, const char *what, _kernel_oserror *e, gboolean send)
+{
+	switch (dci4_errno (e)) {
+	case DCI4_EWOULDBLOCK: case DCI4_EINPROGRESS: case DCI4_ENOTCONN:
+		return GNUTLS_E_AGAIN;
+	case DCI4_EINTR:
+		return GNUTLS_E_INTERRUPTED;
+	case DCI4_ECONNRESET: case DCI4_EPIPE:
+		errno = 0;                      /* (socket.c: a closed connection) */
+		note_error (s, what, e);
+		return GNUTLS_E_PREMATURE_TERMINATION;
+	}
+	note_error (s, what, e);
+	return send ? GNUTLS_E_PUSH_ERROR : GNUTLS_E_PULL_ERROR;
+}
+
+long gnutls_record_recv (gnutls_session_t s, void *data, size_t size)
+{
+	for (;;) {
+		long got, r;
+		_kernel_oserror *e = ssl_io (XAcornSSL_Recv, s->handle, data, size, 0, &got);
+		if (e == NULL)
+			return got;                     /* 0: the server closed it */
+		r = record_error (s, "AcornSSL_Recv", e, FALSE);
+		if (r != GNUTLS_E_AGAIN || !fd_blocking (s->fd))
+			return r;
+		wait_fd (s->fd, FALSE);
+	}
+}
+
+long gnutls_record_send (gnutls_session_t s, const void *data, size_t size)
+{
+	for (;;) {
+		long done, r;
+		_kernel_oserror *e = ssl_io (XAcornSSL_Send, s->handle, (void *) data, size, 0, &done);
+		if (e == NULL)
+			return done;
+		r = record_error (s, "AcornSSL_Send", e, TRUE);
+		if (r != GNUTLS_E_AGAIN || !fd_blocking (s->fd))
+			return r;
+		wait_fd (s->fd, TRUE);
+	}
+}
+
+/* decrypted data waiting in AcornSSL (the socket itself may have none) */
+size_t gnutls_record_check_pending (gnutls_session_t s)
+{
+	long got;
+	unsigned char peek;
+
+	if (s == NULL || s->handle == 0)
+		return 0;
+	return ssl_io (XAcornSSL_Recv, s->handle, &peek, 1, ACORNSSL_MSG_PEEK, &got) == NULL && got > 0;
+}
