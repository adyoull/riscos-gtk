+#ifdef __riscos
+/* RISC OS: no fork() (UnixLib's is a vfork, for exec), so the name is
+   looked up here (the Resolver module answers quickly or from its cache)
+   and the answer is handed over from an idle, as the child's would be
+   from the pipe. */
+static gboolean riscos_lookup_done(gpointer data)
+{
+	SockLookupData *lookup_data = data;
+	GList *addr_list = lookup_data->addr_list;
+
+	lookup_data->io_tag = 0;
+	lookup_data->addr_list = NULL;
+	if (addr_list == NULL)
+		log_error(LOG_PROTOCOL, _("%s:%d: unknown host.\n"),
+			  lookup_data->hostname, lookup_data->port);
+	lookup_data->func(addr_list, lookup_data->data);
+	g_free(lookup_data->canonical_name);
+	g_free(lookup_data->hostname);
+	g_free(lookup_data);
+	return FALSE;
+}
+
+static void riscos_lookup(SockLookupData *lookup_data)
+{
+	struct addrinfo hints, *res = NULL, *ai;
+	gchar port_str[6];
+	gint gai_err;
+
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_flags = AI_CANONNAME;
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	hints.ai_protocol = IPPROTO_TCP;
+	g_snprintf(port_str, sizeof(port_str), "%d", lookup_data->port);
+
+	gai_err = getaddrinfo(lookup_data->hostname, port_str, &hints, &res);
+	if (gai_err != 0) {
+		g_warning("getaddrinfo for %s:%s failed: %s",
+			  lookup_data->hostname, port_str, gai_strerror(gai_err));
+		log_error(LOG_PROTOCOL, _("%s:%s: host lookup failed (%s).\n"),
+			  lookup_data->hostname, port_str, gai_strerror(gai_err));
+		return;
+	}
+	if (res != NULL && res->ai_canonname && strlen(res->ai_canonname) < 255)
+		lookup_data->canonical_name = g_strdup(res->ai_canonname);
+	for (ai = res; ai != NULL; ai = ai->ai_next) {
+		SockAddrData *addr_data = g_new0(SockAddrData, 1);
+		addr_data->family = ai->ai_family;
+		addr_data->socktype = ai->ai_socktype;
+		addr_data->protocol = ai->ai_protocol;
+		addr_data->addr_len = ai->ai_addrlen;
+		addr_data->addr = g_memdup2(ai->ai_addr, ai->ai_addrlen);
+		lookup_data->addr_list = g_list_append(lookup_data->addr_list, addr_data);
+	}
+	if (res != NULL)
+		freeaddrinfo(res);
+}
