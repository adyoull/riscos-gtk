+const char *gnutls_strerror (int error)
+{
+	switch (error) {
+	case GNUTLS_E_SUCCESS: return "Success";
+	case GNUTLS_E_AGAIN: return "Resource temporarily unavailable, try again";
+	case GNUTLS_E_INTERRUPTED: return "Function was interrupted";
+	case GNUTLS_E_UNIMPLEMENTED_FEATURE:
+		return "Not available with RISC OS's AcornSSL";
+	case GNUTLS_E_PUSH_ERROR: case GNUTLS_E_PULL_ERROR:
+		return last_error[0] ? last_error : "Error in the TLS connection";
+	}
+	return last_error[0] ? last_error : "TLS error";
+}
