+int gnutls_init (gnutls_session_t *session, unsigned int flags)
+{
+	*session = g_new0 (struct claws_tls_session, 1);
+	(*session)->fd = -1;
+	return 0;
+}
+
+void gnutls_deinit (gnutls_session_t s)
+{
+	if (s == NULL)
+		return;
+	if (s->handle) {
+		_kernel_swi_regs r;
+		r.r[0] = s->handle;
+		_kernel_swi (XAcornSSL_Close, &r, &r);  /* close_notify; the socket stays open */
+	}
+	g_free (s->hostname);
+	g_free (s);
+}
