+const gchar *claws_ssl_get_cert_file (void)
+{
+	return NULL;                    /* AcornSSL has its own authorities */
+}
+
+const gchar *claws_ssl_get_cert_dir (void)
+{
+	return NULL;
+}
+
+void ssl_init (void)
+{
+	main_thread = g_thread_self ();
+	gnutls_global_init ();
+}
+
+void ssl_done (void)
+{
+	gnutls_global_deinit ();
+}
+
+gnutls_x509_crt_t *ssl_get_certificate_chain (gnutls_session_t session, unsigned int *list_len)
+{
+	*list_len = 0;
+	return NULL;
+}
+
+gboolean ssl_init_socket (SockInfo *sockinfo)
+{
+	gnutls_session_t session;
+	int r;
+
+	gnutls_init (&session, GNUTLS_CLIENT);
+	/* the server's name (SNI): AcornSSL also checks the certificate is
+	   for it. Not for a numeric address (it wouldn't match). */
+	if (sockinfo->use_tls_sni && sockinfo->hostname != NULL &&
+	    !is_numeric_host_address (sockinfo->hostname))
+		gnutls_server_name_set (session, GNUTLS_NAME_DNS, sockinfo->hostname,
+					strlen (sockinfo->hostname));
+	gnutls_transport_set_ptr (session, (gnutls_transport_ptr_t) GINT_TO_POINTER (sockinfo->sock));
+	gnutls_session_set_ptr (session, sockinfo);
+	if ((r = gnutls_handshake (session)) < 0) {
+		log_error (LOG_PROTOCOL, _("TLS connection to %s failed: %s\n"),
+			   sockinfo->hostname ? sockinfo->hostname : "?", session->error);
+		g_warning ("TLS connection failed (%s)", session->error);
+		gnutls_deinit (session);
+		return FALSE;
+	}
+	log_message (LOG_PROTOCOL, _("TLS connection to %s through AcornSSL\n"),
+		     sockinfo->hostname ? sockinfo->hostname : "?");
+	sockinfo->ssl = session;
+	sockinfo->xcred = NULL;
+	return TRUE;
+}
+
+void ssl_done_socket (SockInfo *sockinfo)
+{
+	if (sockinfo && sockinfo->ssl) {
+		gnutls_deinit (sockinfo->ssl);
+		sockinfo->ssl = NULL;
+		sockinfo->xcred = NULL;
+		sockinfo->client_key = NULL;
+	}
+}
+
+#endif /* USE_GNUTLS */
