+/* UnixLib: the RISC OS socket handle behind a file descriptor */
+extern int __get_ro_socket (int sockfd);
+
+#define XAcornSSL_Ioctl          (0x050F81 | 0x20000)
+#define XAcornSSL_Close          (0x050F84 | 0x20000)
+#define XAcornSSL_Recv           (0x050F87 | 0x20000)
+#define XAcornSSL_CreateSession  (0x050F88 | 0x20000)
+#define XAcornSSL_Setsockopt     (0x050F8B | 0x20000)
+#define XAcornSSL_Version        (0x050F8D | 0x20000)
+#define XAcornSSL_Send           (0x050F8F | 0x20000)
+#define ACORNSSL_SOL_SOCKET      0xFFFF
+#define SO_ACORNSSL_HOSTNAME     0x11E0
+#define ACORNSSL_FIONBIO         0x8004667E      /* _IOW('f', 126, int) */
+#define ACORNSSL_MSG_PEEK        0x2
+
+/* Internet module errors: 0x20E00 + a BSD errno */
+#define DCI4_BASE        0x20E00
+#define DCI4_EINTR       4
+#define DCI4_EPIPE       32
+#define DCI4_EWOULDBLOCK 35
+#define DCI4_EINPROGRESS 36
+#define DCI4_ECONNRESET  54
+#define DCI4_ENOTCONN    57
+#define RISCOS_SWI_NOT_KNOWN 0x1E6
+
+/* how long a handshake may take, including the user answering AcornSSL's
+   question about a certificate */
+#define HANDSHAKE_SECONDS 180
+
+struct claws_tls_session {
+	int fd;                 /* UnixLib's descriptor (for select) */
+	int handle;             /* AcornSSL's; 0 = none */
+	void *ptr;
+	char *hostname;
+	char error[256];        /* the last AcornSSL error, for messages */
+};
+
+static char last_error[256];
+
+static int dci4_errno (const _kernel_oserror *e)
+{
+	return (e->errnum & ~0xFF) == DCI4_BASE ? (int) (e->errnum & 0xFF) : -1;
+}
+
+static void note_error (gnutls_session_t s, const char *what, const _kernel_oserror *e)
+{
+	g_snprintf (last_error, sizeof last_error, "%s: %s (&%X)", what, e->errmess,
+		    (unsigned) e->errnum);
+	if (s)
+		g_strlcpy (s->error, last_error, sizeof s->error);
+}
+
+static _kernel_oserror *ssl_io (int swi, int handle, void *buf, size_t len, int flags, long *done)
+{
+	_kernel_swi_regs r;
+	_kernel_oserror *e;
+
+	r.r[0] = handle;
+	r.r[1] = (int) (intptr_t) buf;
+	r.r[2] = (int) len;
+	r.r[3] = flags;
+	e = _kernel_swi (swi, &r, &r);
+	*done = e ? -1 : r.r[0];
+	return e;
+}
+
+static GThread *main_thread;		/* ssl_init's: Claws Mail's main thread */
+
+static gboolean fd_blocking (int fd)
+{
+	int fl = fcntl (fd, F_GETFL, 0);
+	return fl != -1 && !(fl & O_NONBLOCK);
+}
+
+static void wait_fd (int fd, gboolean write)
+{
+	fd_set fds;
+
+	FD_ZERO (&fds);
+	FD_SET (fd, &fds);
+	select (fd + 1, write ? NULL : &fds, write ? &fds : NULL, NULL, NULL);
+}
