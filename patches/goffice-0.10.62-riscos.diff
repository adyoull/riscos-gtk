+					  msg = g_strdup_vprintf (format, args); \
+					  va_end (args);
+#define VPRINTF_MESSAGE(format,args,msg) _VPRINTF_MESSAGE (format, args, msg); \
+					 g_return_if_fail (msg != NULL);
